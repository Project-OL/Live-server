generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                                                           String                         @id @default(uuid()) @db.Uuid
  username                                                     String                         @db.VarChar(255)
  publicId                                                     BigInt                         @unique @map("public_id")
  defaultPublicId                                              BigInt                         @unique @map("default_public_id")
  firstName                                                    String?                        @map("first_name") @db.VarChar(255)
  lastName                                                     String?                        @map("last_name") @db.VarChar(255)
  dateOfBirth                                                  DateTime?                      @map("date_of_birth") @db.Date
  country                                                      String?                        @db.VarChar(100)
  gender                                                       String?                        @db.VarChar(50)
  avatarUrl                                                    String?                        @map("avatar_url")
  bio                                                          String?
  usernameUpdatedAt                                            DateTime?                      @map("username_updated_at")
  status                                                       String                         @default("new") @db.VarChar(50)
  passwordSet                                                  Boolean                        @default(false) @map("password_set")
  profileCompletedAt                                           DateTime?                      @map("profile_completed_at")
  currentVipPublicId                                           BigInt?                        @unique @map("current_vip_public_id")
  vipPublicIdExpiresAt                                         DateTime?                      @map("vip_public_id_expires_at")
  vipPurchaseAt                                                DateTime?                      @map("vip_purchase_at")
  originalPublicId                                             BigInt?                        @unique @map("original_public_id")
  vipSubscriptionActive                                        Boolean                        @default(false) @map("vip_subscription_active")
  vipSubscriptionStartAt                                       DateTime?                      @map("vip_subscription_start_at")
  vipSubscriptionExpiresAt                                     DateTime?                      @map("vip_subscription_expires_at")
  privacyInvisibleVisitor                                      Boolean                        @default(false) @map("privacy_invisible_visitor")
  privacyMysteryLive                                           Boolean                        @default(false) @map("privacy_mystery_live")
  privacyMysteryRank                                           Boolean                        @default(false) @map("privacy_mystery_rank")
  privacyInvisibleOnline                                       Boolean                        @default(false) @map("privacy_invisible_online")
  privacyInvisibleOnlineAt                                     DateTime?                      @map("privacy_invisible_online_at")
  fcmToken                                                     String?                        @map("fcm_token")
  fcmTokenUpdatedAt                                            DateTime?                      @map("fcm_token_updated_at")
  hideMicStatus                                                Boolean                        @default(false) @map("hide_mic_status")
  isSupport                                                    Boolean                        @default(false) @map("is_support")
  privacyUpdatedAt                                             DateTime?                      @map("privacy_updated_at")
  isAgent                                                      Boolean                        @default(false) @map("is_agent")
  isTagged                                                     Boolean                        @default(false) @map("is_tagged")
  lastActiveAt                                                 DateTime?                      @map("last_active_at")
  currentAgencyId                                              String?                        @map("current_agency_id") @db.Uuid
  lastIpAddress                                                String?                        @map("last_ip_address") @db.VarChar(45)
  lastLatitude                                                 Decimal?                       @map("last_latitude") @db.Decimal(9, 6)
  lastLongitude                                                Decimal?                       @map("last_longitude") @db.Decimal(9, 6)
  lastLocatedAt                                                DateTime?                      @map("last_located_at")
  tokenVersion                                                 Int                            @default(0) @map("token_version")
  createdAt                                                    DateTime                       @default(now()) @map("created_at")
  updatedAt                                                    DateTime                       @updatedAt @map("updated_at")
  admin_tags                                                   String[]                       @default([])
  personal_coins_frozen                                        Boolean                        @default(false)
  points_frozen                                                Boolean                        @default(false)
  posting_banned                                               Boolean                        @default(false)
  posting_suspended_until                                      DateTime?
  suspended_until                                              DateTime?
  trading_coins_frozen                                         Boolean                        @default(false)
  accountDeletion                                              AccountDeletion?               @relation("AccountDeletion")
  agency                                                       Agency?
  agencyAgentApplication                                       AgencyAgentApplication?        @relation("AgencyAgentApplications")
  agencyApplicationKyc                                         AgencyApplicationKyc?
  agencyDailyAsHost                                            AgencyDailyEarning[]           @relation("AgencyDailyHost")
  agencyApplicationsAsHost                                     AgencyHostApplication[]        @relation("AgencyAppHost")
  agencyApplicationsResolved                                   AgencyHostApplication[]        @relation("AgencyAppResolver")
  hostAgencyMembership                                         AgencyHost?
  agencyLeaveAsHost                                            AgencyLeaveApplication[]       @relation("AgencyLeaveHost")
  agencyLeaveResolved                                          AgencyLeaveApplication[]       @relation("AgencyLeaveResolver")
  agentTransfersReceived                                       AgentPointTransfer[]           @relation("AgentTransferRecipient")
  agentTransfersSent                                           AgentPointTransfer[]           @relation("AgentTransferSender")
  auditLogs                                                    AuditLog[]
  hostStreamBans                                               HostStreamBan[]                @relation("UserHostBans")
  authIdentifiers                                              AuthIdentifier[]
  authPassword                                                 AuthPassword?
  blockedUsers                                                 BlockList[]                    @relation("BlockedUsers")
  blockedBy                                                    BlockList[]                    @relation("BlockedBy")
  reminderCreator                                              BroadcastReminder[]            @relation("ReminderCreator")
  reminderOwner                                                BroadcastReminder[]            @relation("ReminderOwner")
  tradingCoinTopupOrders                                       CoinTradingTopupOrder[]        @relation("TradingCoinTopupsByAgent")
  tradingCoinTransfersReceived                                 CoinTradingTransfer[]          @relation("TradingCoinTransferRecipient")
  tradingCoinTransferReversals                                 CoinTradingTransfer[]          @relation("TradingCoinTransferReversedBy")
  tradingCoinTransfersSent                                     CoinTradingTransfer[]          @relation("TradingCoinTransferSender")
  conversationMembers                                          ConversationMember[]
  creatorSubsAsHost                                            CreatorSubscription[]          @relation("CreatorSubHost")
  creatorSubsAsFan                                             CreatorSubscription[]          @relation("CreatorSubFan")
  custom_gift_requests                                         custom_gift_requests[]
  linkedDeviceAccounts                                         DeviceLinkedAccount[]
  deviceRegistry                                               DeviceRegistry[]
  face_profile_revocations                                     face_profile_revocations[]
  faceRegistrationAuditLogs                                    FaceRegistrationAuditLog[]
  faceRegistrationSessions                                     FaceRegistrationSession[]
  faceVerificationAttempts                                     FaceVerificationAttempt[]
  fanSpendReceived                                             FanSpend[]                     @relation("FanSpendReceiver")
  fanSpendSent                                                 FanSpend[]                     @relation("FanSpendSender")
  gifterGalleryProgress                                        GiftGalleryProgress[]          @relation("GifterGalleryProgress")
  hostGalleryProgress                                          GiftGalleryProgress[]          @relation("HostGalleryProgress")
  giftsReceived                                                GiftTransaction[]              @relation("GiftsReceived")
  giftsSent                                                    GiftTransaction[]              @relation("GiftsSent")
  guardiansAsGuardian                                          Guardian[]                     @relation("GuardianOf")
  guardiansAsTarget                                            Guardian[]                     @relation("GuardedBy")
  hostLiveSessions                                             HostLiveSession[]
  livePhotoVerificationAttempts                                LivePhotoVerificationAttempt[]
  messageReactions                                             MessageReaction[]
  message_reports_message_reports_host_user_idTousers          MessageReport[]                @relation("message_reports_host_user_idTousers")
  reportedReports                                              MessageReport[]                @relation("Reported")
  reporterReports                                              MessageReport[]                @relation("Reporter")
  sentMessages                                                 Message[]                      @relation("SentMessages")
  monthlyRechargeAggregates                                    MonthlyRechargeAggregate[]
  otp_delivery_audits                                          otp_delivery_audits[]
  otpTokens                                                    OtpToken[]
  postLikes                                                    PostLike[]                     @relation("PostLikes")
  taggedIn                                                     PostTag[]                      @relation("TaggedIn")
  posts                                                        Post[]                         @relation("UserPosts")
  profileVisitors                                              ProfileVisitor[]               @relation("ProfileOwner")
  visitHistory                                                 ProfileVisitor[]               @relation("ProfileVisitor")
  richTierHistoryRows                                          RichTierHistory[]              @relation("RichTierHistoryUser")
  securityPassword                                             SecurityPassword?
  sessions                                                     Session[]
  supportMessagesSent                                          SupportMessage[]               @relation("SupportMessageSender")
  supportTicketsClosed                                         SupportTicket[]                @relation("SupportTicketsClosedBy")
  supportTickets                                               SupportTicket[]                @relation("SupportTicketsAsUser")
  activeStoreItems                                             UserActiveStoreItems[]
  user_face_profiles_user_face_profiles_matched_user_idTousers UserFaceProfile[]              @relation("user_face_profiles_matched_user_idTousers")
  faceProfile                                                  UserFaceProfile?
  following                                                    UserFollow[]                   @relation("Follower")
  followers                                                    UserFollow[]                   @relation("Following")
  userLevel                                                    UserLevel?
  userLivePhoto                                                UserLivePhoto?
  paymentMethods                                               UserPaymentMethod[]
  questionnaireAttempts                                        UserQuestionnaireAttempt[]
  userRichTier                                                 UserRichTier?
  userSettings                                                 UserSettings?
  storePurchasedItems                                          UserStoreItem[]                @relation("StorePurchasedBy")
  storeItems                                                   UserStoreItem[]                @relation("UserStoreItems")
  subscribers                                                  UserSubscriber[]               @relation("Creator")
  subscriptions                                                UserSubscriber[]               @relation("Subscriber")
  vipAssignments                                               UserVipAssignment[]
  currentAgencyAgent                                           User?                          @relation("HostToAgencyAgent", fields: [currentAgencyId], references: [id])
  usersHostedInMyAgency                                        User[]                         @relation("HostToAgencyAgent")
  callerSessions                                               VideoCallSession[]             @relation("CallSessionCaller")
  creatorSessions                                              VideoCallSession[]             @relation("CallSessionCreator")
  videoCallSettings                                            VideoCallSettings?
  vipDailyClaims                                               VipDailyClaim[]
  vipDailyQuotas                                               VipDailyQuota[]
  vipMembershipPurchases                                       VipMembershipPurchase[]
  ownedVipIds                                                  VipPublicId[]                  @relation("VipOwner")
  walletUserLevels                                             WalletUserLevel[]
  wallets                                                      Wallet[]
  payrollAssignmentsAsAgent                                    WithdrawalPayrollAssignment[]  @relation("AgencyPayrollAssignments")
  userRestrictions                                             UserRestriction[]
  hostAdminsCreated                                            LiveStreamAdmin[]              @relation("HostAdminHost")
  hostAdminsReceived                                           LiveStreamAdmin[]              @relation("HostAdminUser")

  @@index([publicId])
  @@index([defaultPublicId])
  @@index([username])
  @@index([status])
  @@index([createdAt(sort: Desc)])
  @@index([isAgent])
  @@index([currentAgencyId])
  @@index([lastActiveAt])
  @@map("users")
}

model AuthIdentifier {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  provider   String    @db.VarChar(50)
  identifier String    @db.VarChar(255)
  isVerified Boolean   @default(false) @map("is_verified")
  verifiedAt DateTime? @map("verified_at")
  isPrimary  Boolean   @default(false) @map("is_primary")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  version    Int       @default(1)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, identifier])
  @@unique([userId, provider])
  @@index([userId])
  @@index([provider])
  @@index([identifier])
  @@map("auth_identifiers")
}

model AuthPassword {
  id                     String   @id @default(uuid()) @db.Uuid
  userId                 String   @unique @map("user_id") @db.Uuid
  passwordHash           String   @map("password_hash") @db.VarChar(255)
  previousPasswordHashes String[] @map("previous_password_hashes")
  lastChangedAt          DateTime @default(now()) @map("last_changed_at")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("auth_passwords")
}

model SecurityPassword {
  id                  String    @id @default(cuid())
  userId              String    @unique @map("user_id") @db.Uuid
  passwordHash        String    @map("password_hash") @db.VarChar(255)
  setAt               DateTime  @default(now()) @map("set_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")
  failedAttempts      Int       @default(0) @map("failed_attempts")
  lastFailedAttemptAt DateTime? @map("last_failed_attempt_at")
  lockedUntil         DateTime? @map("locked_until")
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([lockedUntil])
  @@map("security_passwords")
}

model OtpToken {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String?   @map("user_id") @db.Uuid
  otpHash          String    @map("otp_hash") @db.VarChar(255)
  otpPurpose       String    @map("otp_purpose") @db.VarChar(50)
  targetIdentifier String    @map("target_identifier") @db.VarChar(255)
  isUsed           Boolean   @default(false) @map("is_used")
  attemptCount     Int       @default(0) @map("attempt_count")
  expiresAt        DateTime  @map("expires_at")
  verifiedAt       DateTime? @map("verified_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  user             User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([otpPurpose])
  @@index([targetIdentifier, otpPurpose])
  @@map("otp_tokens")
}

model Session {
  id                    String    @id @default(uuid()) @db.Uuid
  userId                String    @map("user_id") @db.Uuid
  deviceName            String    @map("device_name") @db.VarChar(255)
  deviceId              String    @map("device_id") @db.VarChar(255)
  deviceFingerprint     String?   @map("device_fingerprint") @db.VarChar(500)
  deviceFingerprintHash String?   @map("device_fingerprint_hash") @db.VarChar(64)
  ipHash                String?   @map("ip_hash") @db.VarChar(64)
  userAgentHash         String?   @map("user_agent_hash") @db.VarChar(64)
  refreshTokenHash      String    @unique @map("refresh_token_hash") @db.VarChar(255)
  ipAddress             String    @map("ip_address") @db.VarChar(45)
  userAgent             String?   @map("user_agent") @db.VarChar(500)
  isActive              Boolean   @default(true) @map("is_active")
  isRevoked             Boolean   @default(false) @map("is_revoked")
  lastActiveAt          DateTime  @default(now()) @map("last_active_at")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")
  expiresAt             DateTime  @map("expires_at")
  revokedAt             DateTime? @map("revoked_at")
  loginType             String?   @map("login_type") @db.VarChar(50)
  tokenVersion          Int       @default(0) @map("token_version")
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([deviceId])
  @@index([isActive])
  @@index([expiresAt])
  @@index([userId, deviceId])
  @@map("sessions")
}

model DeviceRegistry {
  id                    String   @id @default(uuid()) @db.Uuid
  userId                String   @map("user_id") @db.Uuid
  deviceId              String   @map("device_id") @db.VarChar(255)
  deviceName            String   @map("device_name") @db.VarChar(255)
  deviceType            String?  @map("device_type") @db.VarChar(50)
  platform              String   @default("web") @db.VarChar(20)
  loginAt               DateTime @default(now()) @map("login_at")
  lastActiveAt          DateTime @default(now()) @map("last_active_at")
  ipAddress             String?  @map("ip_address") @db.VarChar(45)
  userAgent             String?  @map("user_agent") @db.VarChar(500)
  deviceFingerprintHash String?  @map("device_fingerprint_hash") @db.VarChar(64)
  ipHash                String?  @map("ip_hash") @db.VarChar(64)
  userAgentHash         String?  @map("user_agent_hash") @db.VarChar(64)
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceId])
  @@index([userId])
  @@index([userId, lastActiveAt])
  @@map("device_registry")
}

model DeviceLinkedAccount {
  id         String   @id @default(cuid())
  deviceId   String   @map("device_id") @db.VarChar(255)
  userId     String   @map("user_id") @db.Uuid
  linkedAt   DateTime @default(now()) @map("linked_at")
  lastUsedAt DateTime @default(now()) @map("last_used_at")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([deviceId, userId])
  @@index([deviceId])
  @@index([userId])
  @@map("device_linked_accounts")
}

model VipPublicId {
  id             String              @id @default(uuid()) @db.Uuid
  publicId       BigInt              @unique @map("public_id")
  tier           String              @default("NONE") @map("tier") @db.VarChar(50)
  priceGroup     String              @default("STANDARD") @map("price_group") @db.VarChar(50)
  rarityScore    Int                 @default(0) @map("rarity_score")
  matchedRules   String[]            @default([]) @map("matched_rules")
  detectedAt     DateTime            @default(now()) @map("detected_at")
  assignedAt     DateTime?           @map("assigned_at")
  patternType    String?             @map("pattern_type") @db.VarChar(50)
  isAvailable    Boolean             @default(true) @map("is_available")
  currentOwnerId String?             @map("current_owner_id") @db.Uuid
  priceCredits   Int?                @map("price_credits")
  purchasedAt    DateTime?           @map("purchased_at")
  expiresAt      DateTime?           @map("expires_at")
  createdAt      DateTime            @default(now()) @map("created_at")
  assignments    UserVipAssignment[]
  currentOwner   User?               @relation("VipOwner", fields: [currentOwnerId], references: [id])

  @@index([isAvailable])
  @@index([currentOwnerId])
  @@index([expiresAt])
  @@index([tier, assignedAt])
  @@index([assignedAt])
  @@map("vip_public_ids")
}

model UserVipAssignment {
  id          String      @id @default(cuid())
  userId      String      @map("user_id") @db.Uuid
  publicId    BigInt      @map("public_id")
  startsAt    DateTime    @default(now()) @map("starts_at")
  expiresAt   DateTime    @map("expires_at")
  revokedAt   DateTime?   @map("revoked_at")
  isActive    Boolean     @default(true) @map("is_active")
  vipPublicId VipPublicId @relation(fields: [publicId], references: [publicId])
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isActive])
  @@index([expiresAt, isActive])
  @@map("user_vip_assignments")
}

model StoreItem {
  id              String            @id @default(uuid()) @db.Uuid
  name            String            @db.VarChar(255)
  description     String?
  category        StoreItemCategory
  coinCost        Int               @map("coin_cost")
  validityDays    Int               @default(15) @map("validity_days")
  displayImageUrl String            @map("display_image_url")
  effectUrl       String?           @map("effect_url")
  isActive        Boolean           @default(true) @map("is_active")
  sortOrder       Int               @default(0) @map("sort_order")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")
  userItems       UserStoreItem[]

  @@index([category, isActive, sortOrder])
  @@index([isActive])
  @@map("store_items")
}

model UserStoreItem {
  id             String                 @id @default(uuid()) @db.Uuid
  userId         String                 @map("user_id") @db.Uuid
  storeItemId    String                 @map("store_item_id") @db.Uuid
  purchasedById  String                 @map("purchased_by_id") @db.Uuid
  coinsPaid      Int                    @map("coins_paid")
  isActive       Boolean                @default(true) @map("is_active")
  isApplied      Boolean                @default(false) @map("is_applied")
  expiresAt      DateTime               @map("expires_at")
  activatedAt    DateTime?              @map("activated_at")
  expiredAt      DateTime?              @map("expired_at")
  revokedAt      DateTime?              @map("revoked_at")
  idempotencyKey String                 @unique @map("idempotency_key") @db.VarChar(200)
  createdAt      DateTime               @default(now()) @map("created_at")
  updatedAt      DateTime               @updatedAt @map("updated_at")
  activeRows     UserActiveStoreItems[]
  purchasedBy    User                   @relation("StorePurchasedBy", fields: [purchasedById], references: [id])
  storeItem      StoreItem              @relation(fields: [storeItemId], references: [id])
  user           User                   @relation("UserStoreItems", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isApplied])
  @@index([userId, isActive])
  @@index([expiresAt, isActive])
  @@index([storeItemId])
  @@map("user_store_items")
}

model UserActiveStoreItems {
  id              String            @id @default(uuid()) @db.Uuid
  userId          String            @map("user_id") @db.Uuid
  category        StoreItemCategory
  userStoreItemId String?           @map("user_store_item_id") @db.Uuid
  updatedAt       DateTime          @updatedAt @map("updated_at")
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  userStoreItem   UserStoreItem?    @relation(fields: [userStoreItemId], references: [id])

  @@unique([userId, category])
  @@index([userId])
  @@map("user_active_store_items")
}

model AuditLog {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String?  @map("user_id") @db.Uuid
  actionType    String   @map("action_type") @db.VarChar(100)
  actionStatus  String   @map("action_status") @db.VarChar(50)
  actionDetails Json?    @map("action_details")
  ipAddress     String?  @map("ip_address") @db.VarChar(45)
  userAgent     String?  @map("user_agent") @db.VarChar(500)
  deviceId      String?  @map("device_id") @db.VarChar(255)
  createdAt     DateTime @default(now()) @map("created_at")
  user          User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([actionType])
  @@index([createdAt(sort: Desc)])
  @@map("audit_logs")
}

model AccountDeletion {
  id                String    @id @default(cuid())
  userId            String    @unique @map("user_id") @db.Uuid
  scheduledAt       DateTime  @default(now()) @map("scheduled_at")
  deactivationUntil DateTime  @map("deactivation_until")
  deletionAt        DateTime  @map("deletion_at")
  isCancelled       Boolean   @default(false) @map("is_cancelled")
  cancelledAt       DateTime? @map("cancelled_at")
  isDeleted         Boolean   @default(false) @map("is_deleted")
  deletedAt         DateTime? @map("deleted_at")
  reason            String?   @db.VarChar(500)
  ipAddress         String?   @map("ip_address") @db.VarChar(45)
  user              User      @relation("AccountDeletion", fields: [userId], references: [id], onDelete: Cascade)

  @@index([scheduledAt])
  @@index([deactivationUntil])
  @@index([deletionAt])
  @@index([isDeleted])
  @@index([userId])
  @@map("account_deletions")
}

model NextPublicIdSequence {
  id        Int    @id
  nextValue BigInt @map("next_value")

  @@map("next_public_id_sequence")
}

/// Cursor for VIP-pattern pre-generation (horizon ahead of signup sequence). Singleton row id=1.
model PublicIdClassificationProgress {
  id               Int      @id @default(1)
  lastClassifiedId BigInt   @map("last_classified_id")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@map("public_id_classification_progress")
}

model UserSettings {
  id                    String   @id @default(cuid())
  userId                String   @unique @map("user_id") @db.Uuid
  language              String   @default("en") @db.VarChar(10)
  allowMsgFromMutual    Boolean  @default(true) @map("allow_msg_from_mutual")
  allowMsgFromFollowing Boolean  @default(true) @map("allow_msg_from_following")
  allowMsgFromStranger  Boolean  @default(false) @map("allow_msg_from_stranger")
  effectTopRunway       Boolean  @default(true) @map("effect_top_runway")
  effectGift            Boolean  @default(true) @map("effect_gift")
  effectLuckyGift       Boolean  @default(true) @map("effect_lucky_gift")
  effectEntry           Boolean  @default(true) @map("effect_entry")
  effectGlobal          Boolean  @default(true) @map("effect_global")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_settings")
}

model UserFollow {
  id          String   @id @default(cuid())
  followerId  String   @map("follower_id") @db.Uuid
  followingId String   @map("following_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  follower    User     @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
  @@map("user_follows")
}

model ProfileVisitor {
  id        String   @id @default(cuid())
  profileId String   @map("profile_id") @db.Uuid
  visitorId String   @map("visitor_id") @db.Uuid
  visitedAt DateTime @default(now()) @map("visited_at")
  profile   User     @relation("ProfileOwner", fields: [profileId], references: [id], onDelete: Cascade)
  visitor   User     @relation("ProfileVisitor", fields: [visitorId], references: [id], onDelete: Cascade)

  @@unique([profileId, visitorId])
  @@index([profileId, visitedAt])
