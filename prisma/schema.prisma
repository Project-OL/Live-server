// ─── MESSAGING ───
enum ConversationType {
  DIRECT
  GROUP
}

enum MessageType {
  TEXT
  TEXT_COINS
  IMAGE
  VIDEO
  AUDIO
  FILE
  SYSTEM
}

enum MediaType {
  IMAGE
  VIDEO
  AUDIO
  FILE
}

// Async sidecar processing for message media (waveform extraction, transcoding, etc.).
enum MediaProcessingStatus {
  NONE
  PENDING
  ENQUEUED
  READY
  FAILED
}

// Future transcription pipeline; persisted for client UX.
enum MediaTranscriptionStatus {
  NONE
  PENDING
  READY
  FAILED
}

enum ReportReason {
  SPAM
  HARASSMENT
  INAPPROPRIATE_CONTENT
  FAKE_ACCOUNT
  VIOLENCE
  OTHER
}

enum ReportStatus {
  PENDING
  REVIEWED
  RESOLVED
  DISMISSED
}

model Conversation {
  id            String               @id @default(cuid())
  type          ConversationType
  lastMessageAt DateTime?            @map("last_message_at")
  // Monotonic per-conversation message sequence
  lastSeq       BigInt               @default(0) @map("last_seq")
  createdAt     DateTime             @default(now()) @map("created_at")
  updatedAt     DateTime             @updatedAt @map("updated_at")
  members       ConversationMember[]
  messages      Message[]

  @@index([lastMessageAt])
  @@map("conversations")
}

model ConversationMember {
  id                String       @id @default(cuid())
  conversationId    String       @map("conversation_id")
  userId            String       @map("user_id") @db.Uuid
  joinedAt          DateTime     @default(now()) @map("joined_at")
  lastReadAt        DateTime?    @map("last_read_at")
  lastReadMessageId String?      @map("last_read_message_id")
  isMuted           Boolean      @default(false) @map("is_muted")
  mutedUntil        DateTime?    @map("muted_until")
  isDeleted         Boolean      @default(false) @map("is_deleted")
  deletedAt         DateTime?    @map("deleted_at")
  conversation      Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
  @@index([conversationId])
  @@map("conversation_members")
}

model Message {
  id              String            @id @default(cuid())
  conversationId  String            @map("conversation_id")
  senderId        String            @map("sender_id") @db.Uuid
  type            MessageType
  content         String?           @db.Text
  replyToId       String?           @map("reply_to_id")
  isDeleted       Boolean           @default(false) @map("is_deleted")
  deletedAt       DateTime?         @map("deleted_at")
  // Idempotency key (UUID) when set; unique per conversation
  clientMessageId String?           @map("client_message_id")
  isAutoReply     Boolean           @default(false) @map("is_auto_reply")
  // Per-conversation monotonic order
  seq             BigInt            @map("seq")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")
  conversation    Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender          User              @relation("SentMessages", fields: [senderId], references: [id])
  replyTo         Message?          @relation("MessageReplies", fields: [replyToId], references: [id])
  replies         Message[]         @relation("MessageReplies")
  mediaItems      MessageMedia[]
  reactions       MessageReaction[]

  @@unique([conversationId, clientMessageId])
  @@unique([conversationId, seq])
  @@index([conversationId, seq])
  @@index([conversationId, createdAt])
  @@index([senderId])
  @@map("messages")
}

// Transactional outbox: at-least-once WS fan-out after commit
model MessageOutbox {
  id             BigInt    @id @default(autoincrement())
  conversationId String    @map("conversation_id")
  payload        Json
  createdAt      DateTime  @default(now()) @map("created_at")
  publishedAt    DateTime? @map("published_at")

  @@index([publishedAt, id])
  @@map("message_outbox")
}

model MessageMedia {
  id                  String                   @id @default(cuid())
  messageId           String                   @map("message_id")
  mediaType           MediaType                @map("media_type")
  s3Key               String                   @map("s3_key") @db.VarChar(500)
  s3Bucket            String                   @map("s3_bucket") @db.VarChar(255)
  fileName            String?                  @map("file_name") @db.VarChar(255)
  mimeType            String?                  @map("mime_type") @db.VarChar(100)
  sizeBytes           Int?                     @map("size_bytes")
  durationSec         Int?                     @map("duration_sec")
  width               Int?
  height              Int?
  order               Int                      @default(0)
  // Compact waveform: `{ "v": 1, "e": "<base64 u8 peaks>" }` or legacy normalized floats (bounded).
  waveformJson        Json?                    @map("waveform_json")
  codec               String?                  @map("codec") @db.VarChar(32)
  bitrate             Int?                     @map("bitrate")
  sampleRate          Int?                     @map("sample_rate")
  channels            Int?                     @map("channels")
  processingStatus    MediaProcessingStatus    @default(NONE) @map("processing_status")
  transcriptionStatus MediaTranscriptionStatus @default(NONE) @map("transcription_status")
  checksumSha256      String?                  @map("checksum_sha256") @db.VarChar(64)
  createdAt           DateTime                 @default(now()) @map("created_at")
  message             Message                  @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@index([processingStatus, createdAt])
  @@index([createdAt])
  @@map("message_media")
}

model MessageReaction {
  id        String   @id @default(cuid())
  messageId String   @map("message_id")
  userId    String   @map("user_id") @db.Uuid
  emoji     String   @db.VarChar(20)
  createdAt DateTime @default(now()) @map("created_at")
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])

  @@unique([messageId, userId, emoji])
  @@index([messageId])
  @@map("message_reactions")
}

model BlockList {
  id        String   @id @default(cuid())
  blockerId String   @map("blocker_id") @db.Uuid
  blockedId String   @map("blocked_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  blocker   User     @relation("BlockedBy", fields: [blockerId], references: [id])
  blocked   User     @relation("BlockedUsers", fields: [blockedId], references: [id])

  @@unique([blockerId, blockedId])
  @@index([blockerId])
  @@index([blockedId])
  @@map("block_lists")
}

model MessageReport {
  id             String       @id @default(cuid())
  reporterId     String       @map("reporter_id") @db.Uuid
  reportedUserId String       @map("reported_user_id") @db.Uuid
  conversationId String?      @map("conversation_id")
  messageId      String?      @map("message_id")
  reason         ReportReason
  additionalInfo String?      @map("additional_info") @db.Text
  evidenceS3Keys String[]     @map("evidence_s3_keys")
  status         ReportStatus @default(PENDING)
  createdAt      DateTime     @default(now()) @map("created_at")
  reporter       User         @relation("Reporter", fields: [reporterId], references: [id])
  reportedUser   User         @relation("Reported", fields: [reportedUserId], references: [id])

  @@index([reporterId])
  @@index([reportedUserId])
  @@index([createdAt])
  @@map("message_reports")
}

model BroadcastReminder {
  id        String   @id @default(cuid())
  userId    String   @map("user_id") @db.Uuid
  creatorId String   @map("creator_id") @db.Uuid
  remindAt  DateTime @map("remind_at")
  isSent    Boolean  @default(false) @map("is_sent")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation("ReminderOwner", fields: [userId], references: [id])
  creator   User     @relation("ReminderCreator", fields: [creatorId], references: [id])

  @@unique([userId, creatorId])
  @@index([remindAt, isSent])
  @@map("broadcast_reminders")
}

// ── Wallet: coins & points ───────────────────────────────────────────────────

