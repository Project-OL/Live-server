  updated_at    DateTime
  gifts         Gift[]

  @@index([display_order])
  @@index([is_active])
}

model otp_delivery_audits {
  id                  String   @id @db.Uuid
  user_id             String?  @db.Uuid
  purpose             String   @db.VarChar(50)
  means               String   @db.VarChar(20)
  provider            String?  @db.VarChar(40)
  status              String   @db.VarChar(20)
  target_type         String   @db.VarChar(20)
  target_masked       String   @db.VarChar(255)
  charge_minor        Int      @default(0)
  charge_currency     String   @default("INR") @db.VarChar(3)
  provider_message_id String?  @db.VarChar(255)
  fallback_from       String?  @db.VarChar(40)
  route_reason        String?  @db.VarChar(60)
  error               String?  @db.VarChar(500)
  created_at          DateTime @default(now())
  country             String?  @db.VarChar(100)
  users               User?    @relation(fields: [user_id], references: [id])

  @@index([country, created_at(sort: Desc)])
  @@index([created_at(sort: Desc)])
  @@index([means, created_at(sort: Desc)])
  @@index([purpose, created_at(sort: Desc)])
  @@index([status, created_at(sort: Desc)])
  @@index([user_id, created_at(sort: Desc)])
}

model otp_delivery_config {
