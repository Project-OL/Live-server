model CountryLanguageMapping {
  id        String   @id @default(uuid()) @db.Uuid
  country   String   @unique @db.VarChar(100)
  language  String   @db.VarChar(10) // e.g. "en", "ru", "es", "hi"
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("country_language_mappings")
}

enum UserRestrictionType {
  LIVE_CHAT_MUTE
  LIVE_AUDIO_MUTE
  MESSAGING_DISABLE
  LIVE_STREAM_START_BAN
}

model UserRestriction {
  id                String              @id @default(uuid()) @db.Uuid
  userId            String              @map("user_id") @db.Uuid
  type              UserRestrictionType
  restrictedUntil   DateTime            @map("restricted_until") @db.Timestamptz
  reason            String?             @db.Text
  reportId          String?             @map("report_id")
  createdByAdminId  String              @map("created_by_admin_id")
  clearedAt         DateTime?           @map("cleared_at") @db.Timestamptz
  clearedByAdminId  String?             @map("cleared_by_admin_id")
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime            @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type, clearedAt])
  @@index([userId, restrictedUntil])
  @@index([reportId])
  @@map("user_restrictions")
}

model LiveStreamAdmin {
  id           String   @id @default(uuid()) @db.Uuid
  hostUserId   String   @map("host_user_id") @db.Uuid
  adminUserId  String   @map("admin_user_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  hostUser  User @relation("HostAdminHost", fields: [hostUserId], references: [id], onDelete: Cascade)
  adminUser User @relation("HostAdminUser", fields: [adminUserId], references: [id], onDelete: Cascade)

  @@unique([hostUserId, adminUserId])
  @@index([hostUserId])
  @@index([adminUserId])
  @@map("live_stream_admins")
}

