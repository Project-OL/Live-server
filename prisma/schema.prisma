  VIP_MEMBERSHIP_PURCHASE
  POINT_EXCHANGE_TO_COINS
}

enum PointTxType {
  LIVESTREAM_GIFT
  SUBSCRIPTION
  GUARDIAN_PURCHASE
  COMMISSION
