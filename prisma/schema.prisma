}

model custom_gift_requests {
  id                                                                                   String                  @id @db.Uuid
  user_id                                                                              String                  @db.Uuid
  whatsapp_number                                                                      String                  @db.VarChar(32)
  note                                                                                 String?
  coin_cost                                                                            BigInt
  validity_days                                                                        Int?
  ledger_entry_id                                                                      String                  @unique @db.Uuid
  status                                                                               CustomGiftRequestStatus @default(PENDING)
  gift_id                                                                              String?                 @db.Uuid
  admin_note                                                                           String?
  failure_reason                                                                       String?
  refunded                                                                             Boolean                 @default(false)
  refund_ledger_entry_id                                                               String?                 @db.Uuid
  resolved_by_admin_id                                                                 String?                 @db.Uuid
  resolved_at                                                                          DateTime?
  created_at                                                                           DateTime                @default(now())
  updated_at                                                                           DateTime
  gifts                                                                                Gift?                   @relation(fields: [gift_id], references: [id])
  coin_ledger_entries_custom_gift_requests_ledger_entry_idTocoin_ledger_entries        CoinLedgerEntry         @relation("custom_gift_requests_ledger_entry_idTocoin_ledger_entries", fields: [ledger_entry_id], references: [id])
  coin_ledger_entries_custom_gift_requests_refund_ledger_entry_idTocoin_ledger_entries CoinLedgerEntry?        @relation("custom_gift_requests_refund_ledger_entry_idTocoin_ledger_entries", fields: [refund_ledger_entry_id], references: [id], onDelete: Restrict)
  users                                                                                User                    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([status, created_at(sort: Desc)])
  @@index([user_id, created_at(sort: Desc)])
}

model face_profile_revocations {
  id                  String           @id @db.Uuid
  user_id             String           @db.Uuid
  face_profile_id     String?          @db.Uuid
  revoked_by_user_id  String?          @db.Uuid
  revoked_by_admin_id String?          @db.Uuid
  revoke_reason       String?
  rekognition_face_id String?          @db.VarChar(128)
  revoked_at          DateTime         @default(now())
  user_face_profiles  UserFaceProfile? @relation(fields: [face_profile_id], references: [id])
  users               User             @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([revoked_at(sort: Desc)])
  @@index([user_id])
}

model gift_categories {
  id            String   @id @db.Uuid
  name          String   @db.VarChar(255)
  slug          String   @unique @db.VarChar(64)
